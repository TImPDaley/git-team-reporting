<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Git Team Reporting" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Git Team Reporting">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      /* System fonts only — avoid Google Fonts hangs on restricted networks */
      html { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
      code, .font-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace; }
    </style>
    <% if Rails.env.development? %>
      <script>
        // Dev only: clear stale PWA service workers that keep hitting /service-worker
        if ("serviceWorker" in navigator) {
          navigator.serviceWorker.getRegistrations().then(function (regs) {
            regs.forEach(function (reg) { reg.unregister(); });
          });
        }
      </script>
    <% end %>
  </head>

  <body class="min-h-full bg-slate-100 text-slate-900 antialiased">
    <div class="min-h-screen">
      <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-3 sm:px-6">
          <div class="flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-slate-900 text-sm font-bold text-white shadow-sm">
              GT
            </div>
            <div>
              <%= link_to "Git Team Reporting", root_path, class: "text-base font-semibold tracking-tight text-slate-900" %>
              <p class="text-xs text-slate-500">GitHub Enterprise activity reports</p>
            </div>
          </div>
          <nav class="flex flex-wrap items-center gap-1">
            <%= nav_link_to "Home", root_path %>
            <%= nav_link_to "Teams", teams_path %>
            <%= nav_link_to "Repositories", repositories_path %>
            <%= nav_link_to "Reports", reports_path %>
            <%= nav_link_to "Generate", new_report_path %>
            <%= nav_link_to "Settings", settings_path %>
          </nav>
        </div>
      </header>

      <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        <% flash.each do |type, message| %>
          <div class="mb-6 flex items-start gap-3 rounded-xl border px-4 py-3 text-sm shadow-sm <%= flash_class(type) %>" role="alert">
            <span class="mt-0.5 font-semibold uppercase tracking-wide text-[0.65rem] opacity-70"><%= type %></span>
            <span><%= message %></span>
          </div>
        <% end %>

        <%= yield %>
      </main>

      <footer class="border-t border-slate-200 bg-white/60">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-4 text-xs text-slate-500 sm:px-6">
          <span>Local-only · Tokens never stored in the database</span>
          <span>MVP · HTML reports</span>
        </div>
      </footer>
    </div>
  </body>
</html>

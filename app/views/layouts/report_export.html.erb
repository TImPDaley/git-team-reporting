<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : "Activity Report" %></title>
    <style>
      :root { color-scheme: light; }
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; color: #0f172a; margin: 0; background: #f8fafc; }
      main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.25rem 3rem; }
      h1 { font-size: 1.75rem; margin: 0.25rem 0; }
      h2 { font-size: 1.15rem; margin: 1.75rem 0 0.75rem; }
      .meta { color: #475569; font-size: 0.9rem; }
      .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; margin: 1.25rem 0; }
      .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 0.9rem 1rem; }
      .card .label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; color: #64748b; }
      .card .value { font-size: 1.5rem; font-weight: 650; margin-top: 0.25rem; }
      table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #e2e8f0; border-radius: 0.75rem; overflow: hidden; font-size: 0.85rem; }
      th, td { padding: 0.55rem 0.65rem; border-bottom: 1px solid #f1f5f9; text-align: left; vertical-align: top; }
      th { background: #f8fafc; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; color: #64748b; }
      tr.unmatched { background: #fffbeb; }
      .badge { display: inline-block; border-radius: 999px; padding: 0.1rem 0.45rem; font-size: 0.7rem; background: #f1f5f9; color: #334155; }
      .badge.warn { background: #fffbeb; color: #92400e; }
      .badge.ok { background: #ecfdf5; color: #065f46; }
      .muted { color: #64748b; font-size: 0.8rem; }
      ul.unmatched-list { background: #fffbeb; border: 1px solid #fde68a; border-radius: 0.75rem; padding: 1rem 1rem 1rem 1.75rem; }
      @media print { body { background: #fff; } main { max-width: none; padding: 0; } }
    </style>
  </head>
  <body>
    <main>
      <%= yield %>
    </main>
  </body>
</html>

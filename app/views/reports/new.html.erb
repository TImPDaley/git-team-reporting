<% content_for :title, "Generate Report · Git Team Reporting" %>

<div class="mb-8">
  <h1 class="page-title">Generate report</h1>
  <p class="page-subtitle max-w-2xl">
    Select a repository and date range. The app fetches activity from GitHub and builds an HTML report matched to the associated team.
  </p>
</div>

<div class="mb-6 card px-4 py-3 text-sm text-slate-700">
  <p>
    <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Active API endpoint</span><br>
    <code class="font-mono text-xs sm:text-sm"><%= github_api_endpoint %></code>
    <span class="badge <%= github_config.api_endpoint_source == :session ? "badge-emerald" : "badge-slate" %>"><%= github_config.api_endpoint_source %></span>
  </p>
  <p class="mt-2 text-xs text-slate-500">
    Default is github.com (<code class="rounded bg-slate-100 px-1">https://api.github.com</code>).
    For GitHub Enterprise Server use <code class="rounded bg-slate-100 px-1">https://&lt;host&gt;/api/v3</code>.
    Change in <%= link_to "Settings", settings_path, class: "underline font-medium" %>.
  </p>
</div>

<% unless github_token_status.present? %>
  <div class="mb-6 card border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950">
    No GitHub token configured.
    <%= link_to "Open Settings", settings_path, class: "font-semibold underline" %>
    or set <code class="rounded bg-white px-1 font-mono text-xs">GITHUB_TOKEN</code>.
  </div>
<% end %>


<%= form_with url: reports_path, scope: :report, method: :post,
      class: "card max-w-2xl space-y-8 p-6 sm:p-8",
      data: {
        controller: "report-form",
        action: "submit->report-form#submitting"
      } do |f| %>
  <div>
    <div class="flex items-center gap-2">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-900 text-[0.65rem] font-bold text-white">1</span>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Repository</h2>
    </div>
    <div class="mt-4 space-y-4">
      <div>
        <%= f.label :repository_id, "Saved repository", class: "block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :repository_id, @repositories, :id, :full_name,
              { include_blank: "— or enter manually below —", selected: @report_form[:repository_id] },
              { class: "field-input" } %>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :owner, "Owner / org", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :owner, value: @report_form[:owner], class: "field-input font-mono" %>
        </div>
        <div>
          <%= f.label :name, "Repository name", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :name, value: @report_form[:name], class: "field-input font-mono" %>
        </div>
      </div>

      <div>
        <%= f.label :team_id, "Team (required for manual entry)", class: "block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :team_id, Team.ordered, :id, :name,
              { include_blank: "Select team", selected: @report_form[:team_id] },
              { class: "field-input" } %>
      </div>
    </div>
  </div>

  <div class="border-t border-slate-100 pt-8">
    <div class="flex items-center gap-2">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-900 text-[0.65rem] font-bold text-white">2</span>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Date range</h2>
    </div>
    <div class="mt-4 space-y-4">
      <div class="flex flex-wrap gap-2">
        <% @presets.each do |value, label| %>
          <% selected = (@report_form[:preset].presence || "this_week") == value %>
          <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-2 text-sm shadow-sm transition <%= selected ? "border-slate-900 bg-slate-900 text-white" : "border-slate-200 bg-white text-slate-700 hover:bg-slate-50" %>">
            <%= f.radio_button :preset, value,
                  checked: selected,
                  class: "accent-slate-900",
                  data: { report_form_target: "preset", action: "change->report-form#presetChanged" } %>
            <%= label %>
          </label>
        <% end %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2" data-report-form-target="customFields">
        <div>
          <%= f.label :start_date, "Custom start", class: "block text-sm font-medium text-slate-700" %>
          <%= f.date_field :start_date,
                value: @report_form[:start_date],
                class: "field-input",
                data: { report_form_target: "startDate", action: "change->report-form#datesChanged input->report-form#datesChanged" } %>
        </div>
        <div>
          <%= f.label :end_date, "Custom end", class: "block text-sm font-medium text-slate-700" %>
          <%= f.date_field :end_date,
                value: @report_form[:end_date],
                class: "field-input",
                data: { report_form_target: "endDate", action: "change->report-form#datesChanged input->report-form#datesChanged" } %>
        </div>
      </div>
      <p class="text-xs text-slate-500">
        Choose <strong>Custom</strong> (or just pick start/end dates) to use a specific range.
        Wider ranges call GitHub more and can take a few minutes — stay on this page until it finishes.
      </p>
    </div>
  </div>

  <div class="border-t border-slate-100 pt-8">
    <div class="flex items-center gap-2">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-900 text-[0.65rem] font-bold text-white">3</span>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Output format</h2>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      <% @formats.each do |value, meta| %>
        <% selected = (@report_form[:format].presence || "html") == value %>
        <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-2 text-sm shadow-sm transition <%= selected ? "border-slate-900 bg-slate-900 text-white" : "border-slate-200 bg-white text-slate-700 hover:bg-slate-50" %>">
          <%= f.radio_button :format, value, checked: selected, class: "accent-slate-900" %>
          <%= meta[:label] %>
        </label>
      <% end %>
    </div>
    <p class="mt-3 text-xs text-slate-500">
      Generated reports are <strong>saved</strong> under <%= link_to "Reports", reports_path, class: "underline" %>
      with run date, date range, repo, team, and the output file so you can reopen them later.
    </p>
  </div>

  <div class="space-y-3">
    <%= f.submit "Generate & save report",
          class: "#{button_classes(:primary)} w-full sm:w-auto",
          data: { report_form_target: "submit" } %>
    <p class="hidden text-sm text-slate-600" data-report-form-target="status" role="status">
      Fetching activity from GitHub… This can take a while for longer date ranges. Please keep this tab open.
    </p>
  </div>
<% end %>


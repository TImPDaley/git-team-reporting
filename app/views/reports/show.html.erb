<% content_for :title, "Report · #{@report.repository_full_name}" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4 print:mb-4">
  <div>
    <p class="text-sm text-slate-500">
      <%= link_to "Reports", reports_path, class: "hover:underline" %>
      <span class="mx-1 text-slate-300">/</span>
      <span class="badge badge-slate"><%= @report.format_label %></span>
    </p>
    <h1 class="page-title mt-1 font-mono"><%= @report.repository_full_name %></h1>
    <dl class="mt-3 grid gap-2 text-sm text-slate-600 sm:grid-cols-2">
      <div><span class="text-slate-500">Team:</span> <strong class="text-slate-900"><%= @report.team_name %></strong></div>
      <div><span class="text-slate-500">Run date:</span> <strong class="text-slate-900"><%= l(@report.generated_at, format: :long) rescue @report.generated_at %></strong></div>
      <div><span class="text-slate-500">Date range:</span> <strong class="text-slate-900"><%= @report.start_date %> – <%= @report.end_date %></strong></div>
      <div><span class="text-slate-500">File:</span> <span class="font-mono text-xs text-slate-800"><%= @report.filename %></span></div>
    </dl>
  </div>
  <div class="flex flex-wrap gap-2 print:hidden">
    <%= link_to "Download #{@report.format_label}", download_report_path(@report), class: button_classes(:primary) %>
    <button type="button" onclick="window.print()" class="<%= button_classes(:secondary) %>">Print</button>
    <%= link_to "New report", new_report_path(repository_id: @report.repository_id), class: button_classes(:secondary) %>
    <%= button_to "Delete", report_path(@report), method: :delete,
          form: { data: { turbo_confirm: "Delete this saved report?" } },
          class: button_classes(:danger) %>
  </div>
</div>

<div class="card overflow-hidden">
  <div class="border-b border-slate-100 bg-slate-50 px-4 py-2 text-xs font-medium uppercase tracking-wide text-slate-500">
    Archived <%= @report.format_label %> content
  </div>
  <% if @report.html? %>
    <iframe
      title="Report content"
      srcdoc="<%= @report.content_for_display %>"
      class="h-[75vh] w-full border-0 bg-white"
      sandbox=""></iframe>
  <% elsif @report.pdf? %>
    <div class="space-y-3 p-8 text-center">
      <p class="text-sm text-slate-600">
        PDF is stored as a downloadable file. Use <strong>Download PDF</strong> to open it in your viewer.
      </p>
      <%= link_to "Download PDF", download_report_path(@report), class: button_classes(:primary) %>
    </div>
  <% else %>
    <pre class="max-h-[75vh] overflow-auto whitespace-pre-wrap p-4 font-mono text-xs text-slate-800"><%= @report.content_for_display %></pre>
  <% end %>
</div>

<%= form_with model: team, class: "card max-w-xl space-y-5 p-6" do |f| %>
  <% if team.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-900">
      <p class="font-medium"><%= pluralize(team.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-2 list-disc pl-5">
        <% team.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :name, required: true, class: "field-input" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_area :description, rows: 3, class: "field-input" %>
  </div>

  <div class="flex flex-wrap gap-3 pt-1">
    <%= f.submit class: button_classes(:primary) %>
    <%= link_to "Cancel", team.persisted? ? team_path(team) : teams_path, class: button_classes(:secondary) %>
  </div>
<% end %>

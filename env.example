# Copy to .env for local development (dotenv-rails loads .env automatically).
# Never commit real tokens. .env is gitignored.

# ---------------------------------------------------------------------------
# GitHub API
# ---------------------------------------------------------------------------
# REST API *base* URL (not a repository web page).
#
#   GitHub.com (app default):   https://api.github.com
#   GitHub Enterprise Server:   https://YOUR_HOST/api/v3
#
# Override here or in Settings → API endpoint.
GITHUB_API_ENDPOINT=https://api.github.com

# Prefills owner/org on repository and report forms. Leave blank to require
# an explicit owner on each form (or set a session override in Settings).
GITHUB_DEFAULT_OWNER=

# Personal access token — preferred long-lived source for local use.
# Alternative: Settings → session token override (browser only).
# GITHUB_TOKEN=your_token_here
# GITHUB_ENTERPRISE_TOKEN=your_token_here
